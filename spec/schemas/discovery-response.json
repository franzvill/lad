{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lad-a2a.org/schemas/discovery-response.json",
  "title": "LAD-A2A Discovery Response",
  "description": "Response format for the /.well-known/lad/agents endpoint",
  "type": "object",
  "required": ["version", "agents"],
  "properties": {
    "version": {
      "type": "string",
      "description": "LAD-A2A protocol version",
      "pattern": "^\\d+\\.\\d+$",
      "examples": ["1.0"]
    },
    "network": {
      "type": "object",
      "description": "Optional network metadata",
      "properties": {
        "ssid": {
          "type": "string",
          "description": "Network SSID if applicable",
          "examples": ["ExampleHotel-Guest"]
        },
        "realm": {
          "type": "string",
          "description": "Network realm or domain",
          "examples": ["examplehotel.com"]
        }
      }
    },
    "agents": {
      "type": "array",
      "description": "List of discoverable A2A agents (capped to bound a hostile response)",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/agent"
      }
    }
  },
  "$defs": {
    "agent": {
      "type": "object",
      "required": ["name", "agent_card_url"],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 512,
          "description": "Stable identity key (DID). SHOULD be present in v0.2; REQUIRED as of v1.0. Used to dedup and to pin remembered consent.",
          "examples": ["did:web:examplehotel.com#concierge"]
        },
        "name": {
          "type": "string",
          "maxLength": 256,
          "description": "Human-readable agent name",
          "examples": ["Example Hotel Concierge"]
        },
        "description": {
          "type": "string",
          "maxLength": 1024,
          "description": "Brief description of the agent's purpose",
          "examples": ["Hotel services and information"]
        },
        "role": {
          "type": "string",
          "maxLength": 128,
          "description": "Agent role category (advisory; authoritative role is in the verified AgentCard)",
          "examples": ["hotel", "it-support", "facilities"]
        },
        "agent_card_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048,
          "description": "HTTPS URL to the A2A AgentCard (typically /.well-known/agent.json). Non-https URLs are a discovery failure.",
          "examples": ["https://concierge.examplehotel.com/.well-known/agent.json"]
        },
        "capabilities_preview": {
          "type": "array",
          "description": "Untrusted, network-supplied UI hint. Authoritative skills are in the verified A2A AgentCard; the consent UI must render from that card, not from this preview.",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 128
          },
          "examples": [["property-info", "amenities", "housekeeping"]]
        }
      }
    }
  }
}
